# Web3Forms access key, created against rubit-software@protonmail.com at
# https://web3forms.com. Public by design - it can only ever deliver to the one
# address it is bound to - but it lives here rather than in the source so the
# repo does not carry it.
#
# In CI this comes from the WEB3FORMS_ACCESS_KEY repo secret.
#
# IMPORTANT: also switch hCaptcha on as the Block Spam option in the Web3Forms
# dashboard. The widget on the page is client-side only; the dashboard toggle is
# what makes the server reject submissions that lack a valid captcha token.
NUXT_PUBLIC_WEB3FORMS_KEY=

# Optional. Raises the GitHub API rate limit for scripts/fetch-releases.mjs from
# 60/hr to 5000/hr. Not needed unless you rebuild very often.
# GITHUB_TOKEN=
